{
  "name": "dsh-work-progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH 插件：在 Web GUI 输入框上方显示当前工作的转圈进度条与完成百分比 —— 阶段、步骤、工具、已用时与实时生成字数。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "install.mjs",
    "install.cmd",
    "README.md",
    "docs",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
